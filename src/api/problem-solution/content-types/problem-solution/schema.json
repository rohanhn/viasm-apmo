{
  "kind": "collectionType",
  "collectionName": "problem_solutions",
  "info": {
    "singularName": "problem-solution",
    "pluralName": "problem-solutions",
    "displayName": "Problem solution"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "year": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::year.year",
      "required": true
    },
    "file": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    }
  }
}
